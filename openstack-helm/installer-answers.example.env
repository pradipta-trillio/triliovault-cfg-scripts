# Answer file for install_trilio.sh — copy, edit, then:
#
#     bash ./install_trilio.sh --answers my-cloud.env --yes
#
# Format is KEY=value, one per line. It is read through a whitelist (only
# T4OI_* keys, values containing shell metacharacters are rejected), not
# sourced, so a stray file here cannot execute anything.
#
# Precedence, highest first:
#     command-line flag > environment variable > this file > autodetection > default
#
# Anything you leave out is autodetected from the cluster where possible, and
# falls back to the default otherwise. Under --yes a question with no default
# is a hard error rather than a hang.

# --- cloud -----------------------------------------------------------------
# helm = vanilla OpenStack Helm, mosk = Mirantis OpenStack for Kubernetes.
# Autodetected from the presence of the OpenStackDeployment CRD.
T4OI_FLAVOUR=mosk

# Which values_overrides file carries the image tags. The menu is built by
# scanning that directory, so this is whatever file is actually there — today
# 2023.1.yaml / 2023.2.yaml for Helm, mosk25.1.yaml for MOSK. Defaults to
# whatever utils/install.sh (or install_mosk.sh) currently points at.
T4OI_VERSION_FILE=mosk25.1.yaml

# --- images ----------------------------------------------------------------
# Both default to whatever the chosen version file already contains, so a
# mirrored registry works without extra configuration.
T4OI_IMAGE_REGISTRY=docker.io/trilio
T4OI_IMAGE_TAG=6.2.0-stable-1-mosk25.1

# --- cloud details ---------------------------------------------------------
# Autodetected: ceph from the presence of the rbd keyring secret, TLS from
# keystone-tls-public, the public domain from the keystone ingress host.
T4OI_USE_CEPH=yes
T4OI_TLS_PUBLIC=yes
T4OI_INTERNAL_DOMAIN=cluster.local
T4OI_PUBLIC_DOMAIN=triliodata.demo

# Nodes to label triliovault-control-plane=enabled. "all" means every node that
# already carries openstack-control-plane=enabled. Three are recommended.
T4OI_CONTROL_PLANE_NODES=all

# --- optional: CoreDNS host entry (MOSK) -----------------------------------
# Only needed when the backup-target (S3) endpoint FQDN does not already
# resolve inside the cluster. This rewrites a cluster-wide configmap, so it
# defaults to no and is never done silently.
T4OI_ADD_DNS_ENTRY=no
#T4OI_DNS_IP=192.168.0.100
#T4OI_DNS_HOSTNAME=cephquincy.triliodata.demo

# --- credentials -----------------------------------------------------------
# NEVER put these in this file. The installer reads them from the environment
# only, and skips the step entirely when the triliovault-image-registry secret
# already exists in both namespaces.
#
#   bash:  export T4OI_REGISTRY_USERNAME=... T4OI_REGISTRY_PASSWORD=...
#   fish:  set -x T4OI_REGISTRY_USERNAME ...; set -x T4OI_REGISTRY_PASSWORD ...
