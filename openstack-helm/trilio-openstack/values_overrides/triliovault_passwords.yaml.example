## Generated at install time by utils/generate_passwords.sh, either directly or
## via ../../install_trilio.sh. Copy to triliovault_passwords.yaml only if you
## are filling it in by hand.
##
## Regenerating these against a live release rotates the credentials the running
## services already hold. install_trilio.sh therefore skips generation whenever
## triliovault_passwords.yaml already exists; pass --rotate-passwords to force.
endpoints:
  identity:
    auth:
      triliovault_datamover:
        password: <KEYSTONE_DATAMOVER_PASSWORD>
      triliovault_wlm:
        password: <KEYSTONE_WLM_PASSWORD>
  oslo_messaging:
    auth:
      triliovault_wlm:
        password: <RABBITMQ_WLM_PASSWORD>
  oslo_db_triliovault_datamover:
    auth:
      triliovault_datamover:
        password: <DATABASE_DATAMOVER_PASSWORD>
  oslo_db_triliovault_wlm:
    auth:
      triliovault_wlm:
        password: <DATABASE_WLM_PASSWORD>
  oslo_cache:
    auth:
      memcache_secret_key: <MEMCACHE_SECRET_KEY>
