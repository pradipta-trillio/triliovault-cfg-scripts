[client]
rabbitmq_url = <%= @dms_rabbitmq_url %>
# Backup target definitions live in the workloadmgr database, on DMAPI nodes too.
db_url = <%= @dms_client_db_url %>
node_id = <%= @dms_node_id %>
request_timeout = 60
log_level = INFO
log_file = /var/log/triliovault/trilio-dms-client.log
log_max_bytes = 26214400
log_backup_count = 5
db_pool_size = 20
db_max_overflow = 40
db_pool_recycle = 3600
